{
    "name": "hurah/devroc-website-core",
    "description": "Gedeelde opstart, Twig en lokale ontwikkelserver voor de websitetemplates.",
    "type": "library",
    "license": "0BSD",
    "require": {
        "league/commonmark": "^2.10.2",
        "php": "^8.3",
        "symfony/console": "^7.4",
        "symfony/process": "^7.4.5",
        "twig/twig": "^3.27",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "DevRoc\\WebsiteCore\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload-dev": {
        "psr-4": {
            "DevRoc\\WebsiteCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:ci": "@php vendor/bin/phpunit --log-junit build/junit.xml",
        "check": [
            "@validate-package",
            "@test"
        ],
        "validate-package": "@composer validate --strict"
    }
}
